// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// DEVELOPER LAYER — People building on Quellix
// ============================================================

model Developer {
  id            String   @id @default(cuid())
  email         String   @unique
  username      String?  @unique
  passwordHash  String?  @map("password_hash") // nullable — OAuth-only accounts have no password
  fullName      String?  @map("full_name")
  avatarUrl     String?  @map("avatar_url") // Cloudinary URL or provider avatar
  githubId      String?  @unique @map("github_id") // set when linked via GitHub OAuth
  authProvider  String   @default("email") @map("auth_provider") // "email" | "github" | "both"
  emailVerified Boolean  @default(false) @map("email_verified")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  projects           Project[]
  sessions           Session[]
  verificationTokens VerificationToken[]
  authEvents         AuthEvent[]

  // Team: slots where this developer is the workspace owner
  notifications Notification[]

  teamMembersOwned TeamMember[] @relation("TeamOwner")
  // Team: slots where this developer is a collaborator on someone else's workspace
  teamMemberships  TeamMember[] @relation("TeamMember")
  // Invites this developer has sent to others
  teamInvitesSent  TeamInvite[] @relation("TeamInviteOwner")

  @@map("developers")
}

model Project {
  id          String   @id @default(cuid())
  developerId String   @map("developer_id")
  name        String
  slug        String   @unique
  logoUrl     String?  @map("logo_url")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  developer     Developer        @relation(fields: [developerId], references: [id], onDelete: Cascade)
  apiKeys       ApiKey[]
  endUsers      EndUser[]
  sessions      Session[]
  organizations Organization[]
  webhooks      Webhook[]
  authEvents    AuthEvent[]
  settings      ProjectSettings?

  @@index([developerId])
  @@map("projects")
}

model ApiKey {
  id         String     @id @default(cuid())
  projectId  String     @map("project_id")
  name       String
  keyHash    String     @unique @map("key_hash") // SHA-256 of full key — never stored plaintext
  keyPrefix  String     @map("key_prefix") // first ~16 chars for display (qlx_pub_xxxx)
  type       ApiKeyType @default(PUBLISHABLE)
  // Fine-grained permission scopes — empty array means full access for the
  // key type. Reserved for future use; add scope checks in resolveSdkKey.
  // Examples: ["users:read", "users:write", "sessions:revoke"]
  scopes     String[]   @default([])
  lastUsedAt DateTime?  @map("last_used_at")
  expiresAt  DateTime?  @map("expires_at")
  createdAt  DateTime   @default(now()) @map("created_at")
  revokedAt  DateTime?  @map("revoked_at") // null = active; set = revoked

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([keyHash])
  @@map("api_keys")
}

enum ApiKeyType {
  PUBLISHABLE
  SECRET
}

// ============================================================
// END USER LAYER — The actual users of developer's apps
// ============================================================

model EndUser {
  id               String    @id @default(cuid())
  projectId        String    @map("project_id")
  email            String
  passwordHash     String?   @map("password_hash")
  firstName        String?   @map("first_name")
  lastName         String?   @map("last_name")
  profileImageUrl  String?   @map("profile_image_url")
  emailVerified    Boolean   @default(false) @map("email_verified")
  twoFactorEnabled Boolean   @default(false) @map("two_factor_enabled")
  banned           Boolean   @default(false)
  lastSignInAt     DateTime? @map("last_sign_in_at")
  // Arbitrary key-value data the developer wants to attach to their users.
  // Equivalent to Clerk's publicMetadata. Never returned in SDK tokens.
  metadata         Json?
  // Optional ID for linking an EndUser to a record in the developer's own
  // database. Useful for migration from an existing auth system.
  externalId       String?   @map("external_id")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)
  sessions             Session[]
  socialAccounts       SocialAccount[]
  twoFactorBackupCodes TwoFactorBackupCode[]
  organizationMembers  OrganizationMember[]
  verificationTokens   VerificationToken[]
  authEvents           AuthEvent[]

  @@unique([projectId, email])
  @@unique([projectId, externalId]) // enforce uniqueness within a project
  @@index([projectId])
  @@index([email])
  @@index([externalId])
  @@map("end_users")
}

// ============================================================
// SHARED — Session works for both Developer and EndUser
// ============================================================

model Session {
  id           String   @id @default(cuid())
  developerId  String?  @map("developer_id")
  endUserId    String?  @map("end_user_id")
  // projectId is set for end-user sessions. Allows fast revocation of all
  // sessions for a project without joining through EndUser.
  projectId    String?  @map("project_id")
  token        String   @unique
  refreshToken String?  @unique @map("refresh_token")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  expiresAt    DateTime @map("expires_at")
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  developer Developer? @relation(fields: [developerId], references: [id], onDelete: Cascade)
  endUser   EndUser?   @relation(fields: [endUserId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([endUserId])
  @@index([projectId])
  @@index([token])
  @@index([refreshToken])
  @@index([expiresAt])
  @@map("sessions")
}

model SocialAccount {
  id             String    @id @default(cuid())
  endUserId      String    @map("end_user_id")
  provider       String
  providerUserId String    @map("provider_user_id")
  email          String?
  accessToken    String?   @map("access_token")
  refreshToken   String?   @map("refresh_token")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  endUser EndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@unique([provider, providerUserId])
  @@index([endUserId])
  @@map("social_accounts")
}

model TwoFactorBackupCode {
  id        String    @id @default(cuid())
  endUserId String    @map("end_user_id")
  codeHash  String    @map("code_hash")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")

  endUser EndUser @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@index([endUserId])
  @@map("two_factor_backup_codes")
}

// ============================================================
// SHARED — VerificationToken works for both Developer and EndUser
// ============================================================

model VerificationToken {
  id          String    @id @default(cuid())
  developerId String?   @map("developer_id")
  endUserId   String?   @map("end_user_id")
  token       String    @unique
  type        TokenType
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  developer Developer? @relation(fields: [developerId], references: [id], onDelete: Cascade)
  endUser   EndUser?   @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([endUserId])
  @@index([token])
  @@map("verification_tokens")
}

enum TokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR
  // Used during the account-linking flow: when a user tries to register with
  // an email that already belongs to an OAuth-only account, we issue this
  // token type to verify inbox ownership before adding a password to the
  // existing account. The token field stores "<code>:<argon2hash>" so no
  // extra column is needed.
  ACCOUNT_LINK
}

// ============================================================
// DEVELOPER TEAM — Collaborators on a developer's Quellix workspace
// ============================================================

// A confirmed team membership: memberId can access ownerId's workspace.
model TeamMember {
  id        String   @id @default(cuid())
  ownerId   String   @map("owner_id") // the developer who owns the workspace
  memberId  String   @map("member_id") // the collaborator being granted access
  role      String   @default("member") // "member" | "admin"
  createdAt DateTime @default(now()) @map("created_at")

  owner  Developer @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  member Developer @relation("TeamMember", fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([ownerId, memberId])
  @@index([ownerId])
  @@index([memberId])
  @@map("team_members")
}

// A pending invite to join someone's workspace. The invited person may or may not
// have a Quellix account yet — they accept by visiting the link in their email.
model TeamInvite {
  id         String    @id @default(cuid())
  ownerId    String    @map("owner_id")
  email      String // invitee email address
  role       String    @default("member") // "member" | "admin"
  token      String    @unique // secure random token for the accept link
  expiresAt  DateTime  @map("expires_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  acceptedAt DateTime? @map("accepted_at")

  owner Developer @relation("TeamInviteOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId])
  @@index([token])
  @@index([email])
  @@map("team_invites")
}

// ============================================================
// AUTH EVENTS — Audit log for end-user auth activity per project
// ============================================================

model AuthEvent {
  id          String   @id @default(cuid())
  projectId   String?  @map("project_id")
  developerId String?  @map("developer_id") // set for developer-console auth events
  endUserId   String?  @map("end_user_id") // set for end-user auth events
  type        String // "login" | "register" | "logout" | "password_reset" | "email_verified" | etc.
  metadata    Json? // additional event-specific data (provider, error, etc.)
  ipAddress   String?  @map("ip_address")
  userAgent   String?  @map("user_agent")
  createdAt   DateTime @default(now()) @map("created_at")

  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  developer Developer? @relation(fields: [developerId], references: [id], onDelete: SetNull)
  endUser   EndUser?   @relation(fields: [endUserId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([developerId])
  @@index([endUserId])
  @@index([createdAt])
  @@map("auth_events")
}

// ============================================================
// ORGANIZATIONS & MULTI-TENANCY
// ============================================================

model Organization {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  name      String
  slug      String   @unique
  logoUrl   String?  @map("logo_url")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project              @relation(fields: [projectId], references: [id], onDelete: Cascade)
  members OrganizationMember[]
  invites OrganizationInvite[]

  @@index([projectId])
  @@map("organizations")
}

model OrganizationMember {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  endUserId      String   @map("end_user_id")
  role           String   @default("member")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  endUser      EndUser      @relation(fields: [endUserId], references: [id], onDelete: Cascade)

  @@unique([organizationId, endUserId])
  @@index([organizationId])
  @@index([endUserId])
  @@map("organization_members")
}

model OrganizationInvite {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  email          String
  role           String    @default("member")
  token          String    @unique
  expiresAt      DateTime  @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  acceptedAt     DateTime? @map("accepted_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([token])
  @@map("organization_invites")
}

// ============================================================
// WEBHOOKS & EVENTS
// ============================================================

model Webhook {
  id        String   @id @default(cuid())
  projectId String   @map("project_id")
  url       String
  events    String[]
  secret    String
  enabled   Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project  Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  attempts WebhookAttempt[]

  @@index([projectId])
  @@map("webhooks")
}

model WebhookAttempt {
  id          String    @id @default(cuid())
  webhookId   String    @map("webhook_id")
  event       String
  payload     Json
  statusCode  Int?      @map("status_code")
  response    String?
  succeededAt DateTime? @map("succeeded_at")
  failedAt    DateTime? @map("failed_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  webhook Webhook @relation(fields: [webhookId], references: [id], onDelete: Cascade)

  @@index([webhookId])
  @@index([createdAt])
  @@map("webhook_attempts")
}

// ============================================================
// NOTIFICATIONS
// ============================================================

enum NotificationType {
  TEAM_INVITE // Someone sent you a team invite
  TEAM_ACCEPTED // Someone accepted your team invite
  ANNOUNCEMENT // Platform-wide message from Quellix admin
  SYSTEM // Automated system message (e.g. billing, limits)
}

model Notification {
  id          String           @id @default(cuid())
  developerId String           @map("developer_id")
  type        NotificationType
  title       String
  body        String
  metadata    Json? // e.g. { inviteToken, inviterName, role }
  read        Boolean          @default(false)
  createdAt   DateTime         @default(now()) @map("created_at")

  developer Developer @relation(fields: [developerId], references: [id], onDelete: Cascade)

  @@index([developerId])
  @@index([developerId, read])
  @@index([createdAt])
  @@map("notifications")
}

// ============================================================
// PROJECT SETTINGS — Per-project configuration for SDK behaviour
// ============================================================

model ProjectSettings {
  id        String @id @default(cuid())
  projectId String @unique @map("project_id")

  // ── CORS & Security ──────────────────────────────────────────────────────
  // List of origins allowed to make SDK requests using a publishable key.
  // Empty array = open CORS (allow any origin) — suitable for early dev.
  // Add origins in production to prevent unauthorised sites using your key.
  // e.g. ["https://myapp.com", "https://staging.myapp.com"]
  allowedOrigins String[] @default([]) @map("allowed_origins")

  // Whitelist of redirect URIs allowed during OAuth flows.
  // An empty array disables OAuth for this project.
  allowedCallbackUrls String[] @default([]) @map("allowed_callback_urls")

  // ── Registration & Sign-in ───────────────────────────────────────────────
  // Whether new end users can self-register. Set to false to make the project
  // invite-only (users must be created via the secret key API).
  allowSignups Boolean @default(true) @map("allow_signups")

  // Force email verification before a user can sign in.
  requireEmailVerification Boolean @default(false) @map("require_email_verification")

  // Reject email addresses from known disposable email providers.
  blockDisposableEmails Boolean @default(false) @map("block_disposable_emails")

  // Which auth providers end users can use. Empty = all enabled.
  // e.g. ["email", "github", "google"]
  enabledAuthProviders String[] @default([]) @map("enabled_auth_providers")

  // ── Password Policy ──────────────────────────────────────────────────────
  passwordMinLength        Int     @default(8) @map("password_min_length")
  passwordRequireUppercase Boolean @default(false) @map("password_require_uppercase")
  passwordRequireNumber    Boolean @default(false) @map("password_require_number")
  passwordRequireSymbol    Boolean @default(false) @map("password_require_symbol")

  // ── Session Lifetime ─────────────────────────────────────────────────────
  // How long a refresh token (SDK session) lives. Default 30 days.
  sessionDurationDays Int @default(30) @map("session_duration_days")

  // How long an access token (JWT) lives in seconds. Default 900 (15 min).
  jwtDurationSeconds Int @default(900) @map("jwt_duration_seconds")

  // Maximum concurrent active sessions per end user. Null = unlimited.
  // When exceeded, the oldest session is revoked automatically.
  maxSessionsPerUser Int? @map("max_sessions_per_user")

  // ── Custom Branding (Email) ───────────────────────────────────────────────
  // If set, Quellix sends transactional emails (verification, reset) using
  // the developer's own email address instead of noreply@quellix.com.
  customEmailFromName    String? @map("custom_email_from_name")
  customEmailFromAddress String? @map("custom_email_from_address")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@map("project_settings")
}
